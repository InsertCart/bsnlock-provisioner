<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="bsnlock.provisioner">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name="com.bsnlock.provisioner.ProvisionerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="EmiLock Setup"
        android:theme="@style/Theme.EmiLockProvisioner"
        tools:targetApi="31">

        <!--
            NEW FLOW:
            ProvisioningCompleteActivity → just calls setResult(OK) → Setup Wizard finishes fast
            TransferActivity             → dealer-facing screen, taps button to transfer DO to EmiLock
        -->

        <!-- Shown during Setup Wizard — finishes immediately, no download -->
        <activity
            android:name="com.bsnlock.provisioner.ui.ProvisioningCompleteActivity"
            android:exported="false"
            android:theme="@style/Theme.EmiLockProvisioner.Splash">
            <intent-filter>
                <action android:name="android.app.action.MANAGED_DEVICE_SETUP_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.app.action.PROVISIONING_SUCCESSFUL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- LAUNCHER: Dealer opens this after EmiLock is installed to do the transfer -->
        <activity
            android:name="com.bsnlock.provisioner.ui.TransferActivity"
            android:exported="true"
            android:label="EmiLock Setup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QR Generator — run on your office device to generate QR codes for new batches -->
<!--        <activity-->
<!--            android:name=".ui.QRGeneratorActivity"-->
<!--            android:exported="true"-->
<!--            android:label="QR Generator" />-->

        <!-- Device Admin Receiver — CRITICAL for Device Owner provisioning -->
        <receiver
            android:name="com.bsnlock.provisioner.receivers.ProvisionerAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
                <action android:name="android.app.action.DEVICE_OWNER_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Boot Receiver — ensures EmiLock launches after reboot -->
        <receiver
            android:name="com.bsnlock.provisioner.receivers.ProvisionerBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- File Provider — needed for APK install fallback dialog -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- DPC meta-data — tells Android this is a Device Policy Controller -->
        <meta-data
            android:name="android.app.device_admin"
            android:resource="@xml/device_admin" />

    </application>

</manifest>